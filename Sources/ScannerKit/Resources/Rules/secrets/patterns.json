{
  "patterns": [
    {
      "type": "AWS Access Key ID",
      "pattern": "\\bAKIA[0-9A-Z]{16}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "cloud_credential"
    },
    {
      "type": "Google API Key",
      "pattern": "\\bAIza[0-9A-Za-z_\\-]{35}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "service_api_key"
    },
    {
      "type": "Google OAuth Client",
      "pattern": "\\b[0-9]+-[0-9A-Za-z_]{32}\\.apps\\.googleusercontent\\.com",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "bearer_token"
    },
    {
      "type": "Slack Token",
      "pattern": "\\bxox[baprs]-[0-9A-Za-z\\-]{10,48}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "service_api_key"
    },
    {
      "type": "Slack Webhook",
      "pattern": "https://hooks\\.slack\\.com/services/[A-Za-z0-9/]+",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "bearer_token"
    },
    {
      "type": "Stripe Secret Key",
      "pattern": "\\b[sr]k_live_[0-9a-zA-Z]{24,}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "service_api_key"
    },
    {
      "type": "GitHub Token",
      "pattern": "\\bgh[pousr]_[0-9A-Za-z]{36,}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "service_api_key"
    },
    {
      "type": "Twilio API Key",
      "pattern": "\\bSK[0-9a-fA-F]{32}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "service_api_key"
    },
    {
      "type": "Private Key (PEM)",
      "pattern": "-----BEGIN ((?:RSA |EC |DSA |OPENSSH )?PRIVATE KEY)-----(?:\\s|\\\\n|\\\\r)*(?:[A-Za-z0-9+/=]{16,}(?:\\s|\\\\n|\\\\r)*){3,}-----END \\1-----",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "cloud_credential",
      "source": "https://www.rfc-editor.org/rfc/rfc7468.html"
    },
    {
      "type": "Anthropic API Key",
      "pattern": "\\bsk-ant-[A-Za-z0-9_\\-]{20,}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "service_api_key"
    },
    {
      "type": "OpenAI Project Key",
      "pattern": "\\bsk-proj-[A-Za-z0-9_\\-]{20,}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "service_api_key"
    },
    {
      "type": "OpenAI API Key",
      "pattern": "\\bsk-[A-Za-z0-9]{48}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "service_api_key"
    },
    {
      "type": "GitHub Fine-grained PAT",
      "pattern": "\\bgithub_pat_[0-9A-Za-z_]{22,}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "service_api_key"
    },
    {
      "type": "GitLab PAT",
      "pattern": "\\bglpat-[0-9A-Za-z_\\-]{20,}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "service_api_key"
    },
    {
      "type": "HuggingFace Token",
      "pattern": "\\bhf_[0-9A-Za-z]{30,}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "service_api_key"
    },
    {
      "type": "SendGrid API Key",
      "pattern": "\\bSG\\.[0-9A-Za-z_\\-]{20,}\\.[0-9A-Za-z_\\-]{20,}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "service_api_key"
    },
    {
      "type": "Mapbox Secret Token",
      "pattern": "\\bsk\\.[0-9A-Za-z]{20,}\\.[0-9A-Za-z]{20,}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "bearer_token"
    },
    {
      "type": "Telegram Bot Token",
      "pattern": "\\b\\d{8,10}:AA[0-9A-Za-z_\\-]{32,}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "bearer_token"
    },
    {
      "type": "JSON Web Token",
      "pattern": "\\beyJ[A-Za-z0-9_\\-]{8,}\\.[A-Za-z0-9_\\-]{8,}\\.[A-Za-z0-9_\\-]{8,}\\b",
      "captureGroup": 0,
      "entropyGate": 0.0,
      "credentialClass": "bearer_token",
      "rejectIfExpired": true,
      "source": "https://www.rfc-editor.org/rfc/rfc7519.html#section-4.1.4"
    },
    {
      "type": "Generic Credential",
      "pattern": "(?i)(?:api[_-]?key|secret|(?<!attribution)token|password|passwd|client[_-]?secret|access[_-]?key)[\"']?\\s*[:=]\\s*[\"']([A-Za-z0-9_\\-+/]{16,})[\"']",
      "captureGroup": 1,
      "entropyGate": 3.5,
      "credentialClass": "generic_credential",
      "rejectIfTokenMatches": "^[a-z]{2,}(?:[A-Z][a-z]{2,}[0-9]*)+$|^[A-Z][a-z]{2,}(?:[A-Z][a-z]{2,}[0-9]*)+$|^/?[a-z0-9_\\-]+(?:/[a-z0-9_\\-]+)+/?$|^(?:[A-Z]+|[A-Z]?[a-z]+(?:[A-Z][a-z]+)*|[A-Za-z]?[0-9]+)(?:_(?:[A-Z]+|[A-Z]?[a-z]+(?:[A-Z][a-z]+)*|[A-Za-z]?[0-9]+))+$"
    }
  ],
  "provenance": {
    "frameworkDefaultPaths": [
      "/mono/",
      "/monotouch/",
      "/mono-2.0/",
      "/etc/mono/",
      "/usr/share/"
    ],
    "publicClientConfigFiles": [
      "googleservice-info.plist",
      "google-services.json",
      "googleservice-info-dev.plist"
    ],
    "publicClientTypes": [
      "Google API Key",
      "Google OAuth Client"
    ],
    "nonProductionBasenameMarkers": [
      ".test.",
      ".sample.",
      ".example.",
      ".mock.",
      ".fixture."
    ],
    "nonProductionPathMarkers": [
      "sample",
      "example",
      "fixture",
      "mock",
      "/test/",
      "/tests/",
      "testdata",
      "demo/"
    ],
    "publicClientConfigFilePattern": "(?i)googleservice-info[^/]*\\.plist$|google-services[^/]*\\.json$",
    "publicClientConfigSignatures": [
      {
        "name": "Firebase Apple platforms configuration (GoogleService-Info.plist)",
        "requiredKeys": [
          "GOOGLE_APP_ID",
          "API_KEY"
        ],
        "source": "https://firebase.google.com/docs/projects/api-keys",
        "why": "Firebase documents that API keys restricted to Firebase services only identify the project and 'do not need to be treated as secrets'; authorisation is Security Rules, App Check and IAM. Recognised by content as well as name, because apps ship per-environment copies (GoogleService-Info-Prod.plist, PayPal-GoogleService-Info.plist)."
      }
    ],
    "publicClientKeyContexts": [
      {
        "name": "Google Maps Platform key for the Maps or Places SDK",
        "types": [
          "Google API Key"
        ],
        "keyPattern": "(?i)(places|maps|gms|geocod)",
        "source": "https://developers.google.com/maps/api-security-best-practices",
        "reason": "The key sits under a Maps/Places setting. Google's Maps and Places SDKs for iOS take the key inside the app by design, and Google's guidance is to restrict it to the app's bundle ID, not to keep it out of the bundle; whether this key is restricted is server-side state the IPA cannot show."
      }
    ],
    "alwaysPublicTypes": [
      {
        "type": "Google OAuth Client",
        "source": "https://www.rfc-editor.org/rfc/rfc8252#section-8.4",
        "reason": "An OAuth client ID for a native app identifies a public client: RFC 8252 treats native apps as public clients that cannot keep a secret, and Google's native-app flow ships the client ID in the app."
      }
    ],
    "oauthClientSecretContexts": [
      {
        "name": "OAuth client secret in a native app's provider configuration",
        "types": [
          "Generic Credential"
        ],
        "documentMarkers": [
          "client_id",
          "client_secret"
        ],
        "endpointPattern": "(?i)(token_endpoint|auth_endpoint|/oauth2?/)",
        "valuePattern": "(?i)client[_-]?secret[\"']?\\s*[:=]\\s*[\"']([^\"']+)[\"']",
        "source": "https://www.rfc-editor.org/rfc/rfc8252#section-8.5",
        "reason": "RFC 8252 section 8.5: a secret statically included in an app distributed to many users is not a confidential secret and serves only to identify the client. Google says the same of installed-app client secrets (\"In this context, the client secret is obviously not treated as a secret\", https://developers.google.com/identity/protocols/oauth2)."
      }
    ],
    "signedAssertions": [
      {
        "name": "AdAttributionKit impression",
        "types": [
          "JSON Web Token"
        ],
        "headerKeyIDSuffixes": [
          ".adattributionkit",
          ".skadnetwork"
        ],
        "requiredClaims": [
          "impression-identifier",
          "ad-network-identifier",
          "advertised-item-identifier"
        ],
        "source": "https://developer.apple.com/documentation/adattributionkit/generating-jws-impressions",
        "reason": "Apple's AdAttributionKit impression format: a compact JWS whose kid is the ad network ID (ending .adattributionkit, or an existing .skadnetwork ID) and whose payload carries the impression fields. The ad network signs it with the private key it generated at registration, and the app passes it to AppImpression(compactJWS:). It is a signed statement that an ad was shown; it carries a signature, not the key, and grants no access."
      }
    ],
    "vendorFixtureFiles": [
      {
        "sha256": "1111bbce829f5fb803ffbe0786963d3b9263043b84750998fbcf37db198a08c2",
        "name": "Verve HyBid demo ad markup (ur.txt)",
        "source": "https://github.com/pubnative/pubnative-hybid-ios-sdk/blob/bb5d7e9592a5a1c8a23b4182b75adcacfe6ee00e/PubnativeLite/PubnativeLiteDemo/Markup/ur.txt"
      },
      {
        "sha256": "72f254566182e95ab024a198668df7e64c554755894d0c0f403cacb77146773c",
        "name": "Verve HyBid unit-test ad response (AdResponse.json)",
        "source": "https://github.com/pubnative/pubnative-hybid-ios-sdk/blob/bb5d7e9592a5a1c8a23b4182b75adcacfe6ee00e/PubnativeLite/PubnativeLiteTests/EndCard/AdResponse.json"
      }
    ]
  }
}
